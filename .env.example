# copy this file to .env.local for local dev, and add the same two values in
# vercel > project > settings > environment variables.
# both are public by design (row level security protects the data).
# never put the supabase SECRET key (sb_secret_...) or service_role key here

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: PREVIEW environment only. Use a separate Supabase preview project.
# Apply supabase/study-preview.sql there before enabling cloud study backup.
NEXT_PUBLIC_STUDY_CLOUD_ENABLED=false

# Optional AI tutor. Server-only secrets: NEVER prefix these with NEXT_PUBLIC_.
# Disabled until a funded API key, an accessible model and approved user IDs exist.
TUTOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=
TUTOR_PREVIEW_USER_IDS=
